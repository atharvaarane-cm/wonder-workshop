{
  "buildCommand": "cd client && bun install && bun run build",
  "outputDirectory": "client/dist",
  "installCommand": "bun install",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/generate-worker", "schedule": "* * * * *" }
  ]
}
