# Copy this file to .env.local and fill in real values.
# .env.local is gitignored so secrets stay off the repo.
# Reload `npm run dev` after editing.

# Required for /api/chat (Gemini text + tool calls) AND /api/image-gemini
# (Nano Banana Pro image generation). One Gemini key can call both;
# you can also use separate keys if you want quota isolation.
GEMINI_API_KEY=
GEMINI_IMAGE_API_KEY=

# Optional model overrides — leave unset for the defaults below.
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
